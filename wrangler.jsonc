{
  "name": "lampy-paperwork-v59-accounts",
  "account_id": "1c2c8d449b4c98fd53e5a474c213787d",
  "main": "backend/patch-sharing-worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": false,
  "find_additional_modules": false,
  "routes": [
    {
      "pattern": "paperwork-api.ailampy.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://ailampy.com",
    "APP_URL": "https://ailampy.com/paperwork/",
    "SHARE_PREFIX": "/paperwork/account-api/shares"
  },
  "r2_buckets": [
    {
      "binding": "PROJECTS",
      "bucket_name": "lampy-paperwork-pilot-projects",
      "remote": false
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "lampy-paperwork-accounts",
      "database_id": "c533cc7c-2e28-4fa4-aa3b-49810da68765",
      "migrations_dir": "backend/migrations",
      "remote": false
    }
  ]
}
